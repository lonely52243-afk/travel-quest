function vc(){return {x:W/2,y:H*0.46};}
function addFinger(id,x,y){
  var c=vc();
  fingers.set(id,{x:x,y:y,ang:Math.atan2(y-c.y,x-c.x),acc:0,born:performance.now(),trail:[{x:x,y:y}]});
}
function moveFinger(id,x,y){
  var f=fingers.get(id);if(!f)return;
  var c=vc(),dx=x-c.x,dy=y-c.y,r=Math.hypot(dx,dy);
  f.x=x;f.y=y;f.trail.push({x:x,y:y});if(f.trail.length>10)f.trail.shift();
  var a=Math.atan2(dy,dx);
  if(r<30){f.ang=a;return;}
  var d=a-f.ang;if(d>Math.PI)d-=TAU;else if(d<-Math.PI)d+=TAU;
  f.ang=a;
  if(state==='play'){
    var ccw=-d;f.acc+=ccw;
    if(ccw>0){var s=Math.floor(((a+TAU)%TAU)/TAU*12)%12;heat[s]=Math.min(1.2,heat[s]+ccw*0.6);}
  }
}
