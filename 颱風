function drawParts(dt){
  for(var i=parts.length-1;i>=0;i--){
    var p=parts[i];p.l-=dt;
    if(p.l<=0){parts.splice(i,1);continue;}
    var a=clamp(p.l/p.m,0,1);
    if(p.t==='s'){
      p.x+=p.vx*dt;p.y+=p.vy*dt;
      ctx.globalAlpha=a;ctx.fillStyle=p.c;ctx.beginPath();ctx.arc(p.x,p.y,p.z*a+0.5,0,TAU);ctx.fill();
    }else if(p.t==='r'){
      var rr=p.r0+(p.r1-p.r0)*(1-a);
      ctx.globalAlpha=a;ctx.strokeStyle=p.c;ctx.lineWidth=p.lw*a+0.5;ctx.beginPath();ctx.arc(p.x,p.y,rr,0,TAU);ctx.stroke();
    }else if(p.t==='t'){
      p.y-=40*dt;
      ctx.globalAlpha=a;ctx.font='900 '+p.z+'px -apple-system,"PingFang TC",sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.lineWidth=4;ctx.strokeStyle='#3a1f06';ctx.lineJoin='round';ctx.strokeText(p.txt,p.x,p.y);ctx.fillStyle=p.c;ctx.fillText(p.txt,p.x,p.y);
    }else if(p.t==='c'){
      p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=380*dt;p.r+=p.vr*dt;
      ctx.globalAlpha=Math.min(1,a*2);ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.r);ctx.fillStyle=p.c;ctx.fillRect(-p.z/2,-p.z/4,p.z,p.z/2);ctx.restore();
    }else if(p.t==='e'){
      p.x+=p.vx*dt;p.y+=p.vy*dt;p.r+=p.vr*dt;
      ctx.globalAlpha=1;ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.r);ctx.font=p.z+'px serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(p.em,0,0);ctx.restore();
    }
  }
  ctx.globalAlpha=1;
  if(parts.length>500)parts.splice(0,parts.length-500);
}

/* ===== 颱風繪製 ===== */
function drawTyphoon(c,x,y,R,eyeR,ph,e,alpha){
  c.save();c.translate(x,y);
  if(spriteOk&&c===ctx){
    c.rotate(ph);c.globalAlpha=alpha;c.drawImage(sprite,-R,-R,R*2,R*2);c.globalAlpha=1;c.rotate(-ph);
    c.fillStyle='rgba(12,16,34,'+(0.7*alpha)+')';c.beginPath();c.arc(0,0,eyeR*0.8,0,TAU);c.fill();
    c.restore();return;
  }
  var g=c.createRadialGradient(0,0,eyeR,0,0,R);
  g.addColorStop(0,'rgba(210,235,255,'+(0.30*alpha)+')');
  g.addColorStop(1,'rgba(120,170,230,0)');
  c.fillStyle=g;c.beginPath();c.arc(0,0,R,0,TAU);c.fill();
  var arms=4,seg=26,spiral=Math.PI*(1.3+e*0.006);
  var lw=Math.max(2,R*0.075);
  c.lineCap='round';
  for(var pass=0;pass<2;pass++){
    for(var k=0;k<arms;k++){
      for(var i=0;i<seg;i++){
        var t0=i/seg,t1=(i+1)/seg;
        var r0=eyeR+(R-eyeR)*t0,r1=eyeR+(R-eyeR)*t1;
        var a0=ph+k*Math.PI/2+t0*spiral,a1=ph+k*Math.PI/2+t1*spiral;
        c.strokeStyle=pass===0?'rgba(190,225,255,'+(alpha*(0.55-0.4*t0))+')':'rgba(255,255,255,'+(alpha*(0.8-0.7*t0))+')';
        c.lineWidth=(pass===0?lw:lw*0.35)*(1-0.55*t0);
        c.beginPath();c.moveTo(Math.cos(a0)*r0,Math.sin(a0)*r0);c.lineTo(Math.cos(a1)*r1,Math.sin(a1)*r1);c.stroke();
      }
    }
  }
  c.fillStyle='rgba(12,16,34,'+(0.88*alpha)+')';c.beginPath();c.arc(0,0,eyeR,0,TAU);c.fill();
  c.strokeStyle='rgba(255,255,255,'+(0.85*alpha)+')';c.lineWidth=2;c.beginPath();c.arc(0,0,eyeR,0,TAU);c.stroke();
  c.restore();
}
function drawRain(dt,e){
  var nd=Math.min(70,Math.floor(e/100*70));
  ctx.strokeStyle='rgba(180,210,255,0.35)';ctx.lineWidth=1.5;ctx.beginPath();
  for(var i=0;i<nd;i++){
    var d=drops[i];d.y+=d.v*dt;d.x-=d.v*dt*0.3;
    if(d.y>H||d.x<0){d.y=-20;d.x=Math.random()*W*1.3;}
    ctx.moveTo(d.x,d.y);ctx.lineTo(d.x+d.l*0.3,d.y-d.l);
  }
  ctx.stroke();
}
function drawLightning(dt,e,tx,ty,spread){
  if(e>45&&boltT<=0&&Math.random()<0.6*dt*(e/100)){
    boltT=0.25;bolt=[];var bx=Math.random()*W,tx2=tx+(Math.random()-0.5)*spread;
    for(var i=0;i<=8;i++){var u=i/8;bolt.push({x:bx+(tx2-bx)*u+(i>0&&i<8?(Math.random()-0.5)*40:0),y:ty*u});}
    thunder();addShake(3);
  }
  if(boltT>0){
    boltT-=dt;var al=clamp(boltT/0.25,0,1);
    ctx.fillStyle='rgba(255,255,255,'+(al*0.12)+')';ctx.fillRect(0,0,W,H);
    ctx.strokeStyle='rgba(255,245,170,'+al+')';ctx.lineWidth=3;ctx.lineJoin='miter';
    ctx.beginPath();ctx.moveTo(bolt[0].x,bolt[0].y);
    for(var j=1;j<bolt.length;j++)ctx.lineTo(bolt[j].x,bolt[j].y);
    ctx.stroke();
  }
}
function drawWaves(){
  var t=performance.now()/1000;
  ctx.strokeStyle='rgba(255,255,255,0.07)';ctx.lineWidth=2;
  for(var i=0;i<16;i++){
    var y0=70+i*(H-140)/15;ctx.beginPath();
    for(var x=0;x<=W;x+=12){var yy=y0+Math.sin(x*0.03+t*1.5+i)*3;if(x===0)ctx.moveTo(x,yy);else ctx.lineTo(x,yy);}
