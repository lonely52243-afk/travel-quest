      updateHud();drawGame(dt);
    }else if(state==='play'){
      stepPlay(dt);
      phase-=(0.5+energy*0.02+smooth*0.45)*dt;
      setWind(0.02+0.28*(energy/100)*(0.35+0.65*clamp(Math.abs(smooth)/6,0,1)),350+energy*9+Math.abs(smooth)*30);
      updateHud();drawGame(dt);
    }else if(state==='finish'){
      finishT-=dt;phase-=(0.5+finalE*0.02)*dt;
      setWind(0.1+0.25*finalE/100,500+finalE*8);
      updateHud();drawGame(dt);
      if(finishT<=0){setTxt('count','');goAim();}
    }else if(state==='land'){
      stepLand(dt);
      if(state==='land'){setWind(0.12+0.22*finalE/100,450+finalE*7);drawLand(dt);}
    }
    drawParts(dt);
    ctx.restore();
  }
  requestAnimationFrame(loop);
}
var skipDay=null,seen=null;
try{skipDay=localStorage.getItem('typhoon_skip');seen=localStorage.getItem('typhoon_seen');}catch(e){}
resize();
goHome();
requestAnimationFrame(loop);
})();
</script>
