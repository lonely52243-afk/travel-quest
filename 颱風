/* ===== 路徑取樣與模擬（預覽與實際結果完全一致） ===== */
function rmax(){return 0.2+finalE/100*2.2;}
function buildSamples(pts,Rm){
  var out=[],dec=1,step=0.04;
  out.push({lon:pts[0][0],lat:pts[0][1],R:Rm});
  for(var i=1;i<pts.length;i++){
    var x0=pts[i-1][0],y0=pts[i-1][1],x1=pts[i][0],y1=pts[i][1];
    var seg=Math.hypot((x1-x0)*COSL,y1-y0),n=Math.max(1,Math.round(seg/step));
    for(var k=1;k<=n;k++){
      var u=k/n,lon=x0+(x1-x0)*u,lat=y0+(y1-y0)*u;
      if(inPoly(lon,lat))dec=Math.max(0.6,dec-0.2*(step/0.55));else dec=Math.min(1,dec+0.03*(step/0.55));
      out.push({lon:lon,lat:lat,R:Rm*dec});
    }
  }
  return out;
}
function simulate(samples){
  var hit=[],soft=[],count=0,i,k;
  for(k=0;k<NC;k++){hit.push(-1);soft.push(-1);}
  for(i=0;i<samples.length;i++){
    var sp=ll2xy(samples[i].lon,samples[i].lat);
    for(k=0;k<NC;k++){
      if(hit[k]>=0)continue;
      var c=COUNTIES[k],d=Math.hypot(c.px-sp.x,c.py-sp.y)/MAP.s;
      if(d<=samples[i].R*c.k){hit[k]=i;count++;}
      else if(c.k<1&&soft[k]<0&&d<=samples[i].R)soft[k]=i;
    }
  }
  return {hit:hit,soft:soft,count:count};
}
function aimBase(){
  return [[aim.ax,aim.ay],[aim.ax+Math.cos(aim.dir)*5.5/COSL,aim.ay+Math.sin(aim.dir)*5.5]];
}
function rng(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
/* 隨機偏移：整條路徑隨機轉個角度 + 左右蛇行，越遠偏越多（像預報誤差圈） */
function wobble(pts,seed,bend,bu){
  var r=rng(seed),rot=(r()-0.5)*0.22,p1=r()*TAU,p2=r()*TAU,f1=1+r()*1.5,f2=2.5+r()*2,A=0.34;
  var d=[],i,k,j;
  for(i=1;i<pts.length;i++){
    var seg=Math.hypot((pts[i][0]-pts[i-1][0])*COSL,pts[i][1]-pts[i-1][1]),n=Math.max(1,Math.ceil(seg/0.2));
    for(k=(i===1?0:1);k<=n;k++){var u=k/n;d.push([pts[i-1][0]+(pts[i][0]-pts[i-1][0])*u,pts[i-1][1]+(pts[i][1]-pts[i-1][1])*u]);}
  }
  var c=Math.cos(rot),sn=Math.sin(rot),R=[],cum=[0],tot=0;
  for(j=0;j<d.length;j++){
    var vx=(d[j][0]-d[0][0])*COSL,vy=d[j][1]-d[0][1];
    R.push([vx*c-vy*sn,vx*sn+vy*c]);
    if(j>0){tot+=Math.hypot(R[j][0]-R[j-1][0],R[j][1]-R[j-1][1]);cum.push(tot);}
  }
  var out=[];
  for(j=0;j<d.length;j++){
    var a=R[Math.max(0,j-1)],b=R[Math.min(d.length-1,j+1)],tx=b[0]-a[0],ty=b[1]-a[1],L=Math.hypot(tx,ty)||1;
    var u2=tot>0?cum[j]/tot:0,off=A*Math.min(1,u2*3)*(0.6*Math.sin(u2*f1*TAU+p1)+0.4*Math.sin(u2*f2*TAU+p2))+(bend?bend*Math.max(0,u2-bu)*2.4:0);
    out.push([d[0][0]+(R[j][0]-ty/L*off)/COSL,d[0][1]+R[j][1]+tx/L*off]);
  }
  return out;
}

/* ===== 瞄準畫面 ===== */
function setRing(th){
  aim.th=th;aim.ax=RC[0]+RA*Math.cos(th);aim.ay=RC[1]+RB*Math.sin(th);
  aim.dir=Math.atan2(RC[1]-aim.ay,(RC[0]-aim.ax)*COSL);
}
function aimStart(x,y){
  var bar=$('aimBar').getBoundingClientRect();
  if(y>bar.top-4)return false;
  var lon=LON0+(x-MAP.left)/(COSL*MAP.s),lat=LAT1-(y-MAP.top)/MAP.s;
  setRing(Math.atan2((lat-RC[1])/RB,(lon-RC[0])/RA));
  aim.s={x:x,y:y};aim.pull=null;updateAim();return true;
}
function aimMove(x,y){
  if(!aim.s)return;
  var vx=x-aim.s.x,vy=y-aim.s.y;
  if(Math.hypot(vx,vy)<14)return;
  aim.dir=Math.atan2(vy,-vx);aim.pull={x:x,y:y};updateAim();
}
var SEEDS=[11,23,37,41,53,67,79,83,97,101];
var CLD=null;
function clsDense(){
  if(CLD)return CLD;
  CLD=[null];
  for(var k=1;k<=9;k++){
    var pts=CLASSES[k].pts,o=[];
    for(var i=1;i<pts.length;i++){
      var seg=Math.hypot((pts[i][0]-pts[i-1][0])*COSL,pts[i][1]-pts[i-1][1]),n=Math.max(1,Math.ceil(seg/0.1));
      for(var q=0;q<=n;q++){var u=q/n;o.push([(pts[i-1][0]+(pts[i][0]-pts[i-1][0])*u)*COSL,pts[i-1][1]+(pts[i][1]-pts[i-1][1])*u]);}
    }
    CLD.push(o);
  }
  return CLD;
}
function classify(b){
  var D=clsDense(),pts=[],i,k,q,x0=b[0][0],y0=b[0][1],x1=b[1][0],y1=b[1][1];
  for(i=0;i<=60;i++){
    var u=i/60,lon=x0+(x1-x0)*u,lat=y0+(y1-y0)*u;
    if(lon>118.8&&lon<123.4&&lat>21.2&&lat<26.2)pts.push([lon*COSL,lat]);
  }
  if(pts.length<4)return {k:0,p:4.07};
  var best=0,bd=9;
  for(k=1;k<=9;k++){
    var cp=CLASSES[k].pts,L=cp.length-1;
    if(((cp[L][0]-cp[0][0])*COSL)*((x1-x0)*COSL)+(cp[L][1]-cp[0][1])*(y1-y0)<0)continue;
    var sum=0;
    for(i=0;i<pts.length;i++){
      var m=9;
      for(q=0;q<D[k].length;q++){var d=Math.hypot(pts[i][0]-D[k][q][0],pts[i][1]-D[k][q][1]);if(d<m)m=d;}
      sum+=m;
    }
    var avg=sum/pts.length;
    if(avg<bd){bd=avg;best=k;}
  }
  return bd>0.8?{k:0,p:4.07}:{k:best,p:CLASSES[best].p};
}
function evalRing(th){
  var ax=RC[0]+RA*Math.cos(th),ay=RC[1]+RB*Math.sin(th),dir=Math.atan2(RC[1]-ay,(RC[0]-ax)*COSL);
  var base=[[ax,ay],[ax+Math.cos(dir)*5.5/COSL,ay+Math.sin(dir)*5.5]],t=0,R=rmax(),s;
  for(s=0;s<4;s++)t+=simulate(buildSamples(wobble(base,SEEDS[s]),R)).count;
  return t/4;
}
var COMPASS=['東','東北','北','西北','西','西南','南','東南'];
function updateAim(){
  var base=aimBase(),R=rmax(),k,s,freq=[],lo=99,hi=0;
  aim.samples=buildSamples(base,R);aim.cone=[];
  for(k=0;k<NC;k++)freq.push(0);
  for(s=0;s<SEEDS.length;s++){
    var tr=wobble(base,SEEDS[s]);aim.cone.push(tr);
    var sim=simulate(buildSamples(tr,R));
    lo=Math.min(lo,sim.count);hi=Math.max(hi,sim.count);
    for(k=0;k<NC;k++)if(sim.hit[k]>=0)freq[k]++;
  }
  aim.lo=lo;aim.hi=hi;
  var cl=classify(base);aim.cls=cl.k;aim.p=cl.p;aim.rare=(18-cl.p)/100;
  $('aimPrev').textContent='會影響幾個縣市？發射後才知道！';
