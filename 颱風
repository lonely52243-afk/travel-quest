function stepPlay(dt){
  remain-=dt;
  var list=[];fingers.forEach(function(f){list.push(f);});
  list.sort(function(a,b){return a.born-b.born;});
  var eff=0;
  if(list.length>=2)eff=Math.min(list[0].acc,list[1].acc);
  else if(list.length===1)eff=list[0].acc*0.35;
  list.forEach(function(f){f.acc=0;});
  smooth+=(eff/dt-smooth)*Math.min(1,dt*9);
  var th=0.5,cov=0,i;
  for(i=0;i<12;i++){cov+=Math.min(heat[i]/th,1);heat[i]=Math.max(0,heat[i]-0.3*dt);}
  balance=cov/12;balSum+=balance;balN++;
  var g=remain<=5?1.3:1;
  if(smooth>0.6){energy+=Math.pow(Math.min(smooth,16)/9.4,1.5)*3.6*g*(0.2+0.8*balance)/(energy<100?1:1+(energy-100)/50)*dt;}
  else if(smooth<-0.6){energy+=smooth/9.4*5.5*dt;}
  if(smooth<2)energy-=3.5*dt;
  energy-=(0.8+energy*0.012)*dt;
  energy=Math.max(0,energy);
  if(smooth>1.5){
    for(i=0;i<Math.min(2,list.length);i++){var f=list[i];addSpark(f.x+rnd(-6,6),f.y+rnd(-6,6),rnd(-60,60),rnd(-60,60),0.45,i?'#ffffff':'#9fe3ff',3);}
  }
  var ten=Math.floor(energy/10);
  if(ten>lastTen){
    var c=vc();addText(c.x+rnd(-70,70),c.y-Math.min(W*0.44,H*0.31)*0.55,'↑ 增強','#9fe3ff',20,0.9);
    tone(440+ten*40,0.09,'triangle',0.1);
  }
  lastTen=ten;
  var ci=catIdx(energy);
  if(ci>lastCatIdx){
    var cc=vc(),w=windOf(energy),rr=Math.min(W*0.44,H*0.31);
    banner('升格為'+catOf(w,energy)+'！','風速 '+w+' m/s');
    flashScreen();addRing(cc.x,cc.y,20,rr*1.3,0.8,'#ffffff',7);addRing(cc.x,cc.y,10,rr*1.0,0.6,'#9fe3ff',5);
    addShake(9);thunder();buzz(70);
    tone(523,0.12,'square',0.12,0);tone(659,0.12,'square',0.12,0.08);tone(784,0.12,'square',0.12,0.16);tone(1047,0.22,'square',0.12,0.24);
  }
  lastCatIdx=Math.max(lastCatIdx,ci);
  /* ===== 緊張感與即時回饋 ===== */
