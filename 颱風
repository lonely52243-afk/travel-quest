function audioInit(){
  try{
    if(!AC){
      var Ctor=window.AudioContext||window.webkitAudioContext;
      if(!Ctor)return;
      AC=new Ctor();master=AC.createGain();master.gain.value=muted?0:1;master.connect(AC.destination);
      var len=AC.sampleRate*2,buf=AC.createBuffer(1,len,AC.sampleRate),ch=buf.getChannelData(0);
      for(var i=0;i<len;i++)ch[i]=Math.random()*2-1;
      NB=buf;
      var src=AC.createBufferSource();src.buffer=buf;src.loop=true;
      wF=AC.createBiquadFilter();wF.type='bandpass';wF.frequency.value=400;wF.Q.value=0.7;
      wG=AC.createGain();wG.gain.value=0;
      src.connect(wF);wF.connect(wG);wG.connect(master);src.start(0);
    }
    if(AC.state==='suspended')AC.resume();
  }catch(e){}
}
function tone(f,d,type,v,delay){
  if(!AC)return;
  try{
    var t=AC.currentTime+(delay||0),o=AC.createOscillator(),g=AC.createGain();
    o.type=type||'square';o.frequency.value=f;
    g.gain.setValueAtTime(0.0001,t);g.gain.exponentialRampToValueAtTime(v||0.12,t+0.01);g.gain.exponentialRampToValueAtTime(0.0001,t+d);
    o.connect(g);g.connect(master);o.start(t);o.stop(t+d+0.02);
  }catch(e){}
}
function thunder(){
  if(!AC||!NB)return;
  try{
    var t=AC.currentTime,s=AC.createBufferSource();s.buffer=NB;
    var f=AC.createBiquadFilter();f.type='lowpass';f.frequency.value=220;
    var g=AC.createGain();g.gain.setValueAtTime(0.7,t);g.gain.exponentialRampToValueAtTime(0.001,t+1.3);
    s.connect(f);f.connect(g);g.connect(master);s.start(t);s.stop(t+1.4);
  }catch(e){}
}
function setWind(v,fr){
  if(!AC||!wG)return;
  try{wG.gain.setTargetAtTime(v,AC.currentTime,0.12);wF.frequency.setTargetAtTime(fr,AC.currentTime,0.12);}catch(e){}
}
function setMute(m){
  muted=m;
  try{localStorage.setItem('typhoon_mute',m?'1':'0');}catch(e){}
  if(master)master.gain.value=m?0:1;
  $('mute').textContent=m?'🔇':'🔊';
}
