    else if(state==='aim'){drawAim(dt);}
    else if(state==='ready'){
      readyT-=dt;phase-=0.5*dt;
      var cn=Math.max(1,Math.ceil(readyT));
      if(cn!==lastCountNum){lastCountNum=cn;tone(520,0.12,'square',0.1);buzz(20);}
      setTxt('count',String(cn));
      if(readyT<=0){
        state='play';fingers.forEach(function(f){f.acc=0;});
        setTxt('count','轉！');$('count').className='pop';tone(880,0.28,'square',0.12);buzz(60);
        setTimeout(function(){if(state==='play')setTxt('count','');},700);
      }
