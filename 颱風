  $('aimInfo').innerHTML='<b>從'+COMPASS[idx]+'方海面出發'+(Math.abs(off)>3?('・偏離直衝 '+Math.round(Math.abs(off))+'°'+(off>0?'（偏左）':'（偏右）')):'・直衝台灣')+'</b><br>'+(cl.k?('最接近歷史第 '+cl.k+' 類（占比 '+cl.p.toFixed(2)+'%）'):'歷史少見的特殊路徑（約 4.07%）')+'・冷門路徑加成 +'+Math.round(aim.rare*100)+'%';
}
