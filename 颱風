  fxT-=dt;
  if(sec<lastSec){
    lastSec=sec;
    if(sec<=10&&sec>=1){
      $('vig').className=sec<=5?'crit':'warn';
      $('tLeft').parentNode.classList.add('urgent');
      tone(sec<=5?880:660,0.07,'square',sec<=5?0.12:0.07);buzz(sec<=5?25:12);
    }
    if(sec<=5&&sec>=1){
      var ce=$('count');ce.className='';void ce.offsetWidth;ce.className='pop';ce.textContent=String(sec);lastHud.count=String(sec);
      addRing(cn2.x,cn2.y,10,Math.min(W*0.45,H*0.32),0.5,'#ff6a5a',5);
      if(sec===5){banner('最後 5 秒！衝刺！','能量成長 +30%');sprint=true;addShake(5);}
    }
  }
  if(energy>=100&&!over100){over100=true;banner('突破 100%！','能量沒有上限，繼續衝！');flashScreen();addShake(8);buzz(60);tone(784,0.1,'square',0.12,0);tone(1047,0.1,'square',0.12,0.08);tone(1319,0.25,'square',0.12,0.16);}
  if(smooth<2&&list.length>=0)idleT+=dt;else idleT=0;
  if(idleT>1.0&&fxT<=0){addText(cn2.x,cn2.y-60,'別停手！','#ff6a5a',26,0.9);buzz(30);tone(180,0.15,'sawtooth',0.1);fxT=1.5;idleT=0.3;}
  else if(smooth>8.5&&fxT<=0){var pw=['飆速！','手速爆表！','颱風笑了','老闆在發抖'];addText(cn2.x+rnd(-80,80),cn2.y-rnd(40,110),pw[Math.floor(Math.random()*pw.length)],'#ffe27a',22,0.9);fxT=1.3;}
  if(balance>0.92&&!perfect){perfect=true;addText(cn2.x,cn2.y+80,'完美對稱 ✨','#9fe3ff',24,1.1);tone(1047,0.12,'triangle',0.1);buzz(20);}
  else if(balance<0.7)perfect=false;
  var hint;
  if(list.length<2)hint=list.length===1?'再加一根手指！兩指一起畫':'用兩根手指一起畫圈！';
