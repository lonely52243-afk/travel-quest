/* ===== 地圖（像素風、縣市分區） ===== */
function ll2xy(lon,lat){return {x:MAP.left+(lon-LON0)*COSL*MAP.s,y:MAP.top+(LAT1-lat)*MAP.s};}
function inPoly(x,y){
  var c=false;
  for(var i=0,j=OUTLINE.length-1;i<OUTLINE.length;j=i++){
    var xi=OUTLINE[i][0],yi=OUTLINE[i][1],xj=OUTLINE[j][0],yj=OUTLINE[j][1];
    if(((yi>y)!==(yj>y))&&(x<(xj-xi)*(y-yi)/(yj-yi)+xi))c=!c;
  }
  return c;
}
function cIndex(name){for(var i=0;i<NC;i++){if(COUNTIES[i].n===name)return i;}return -1;}
function buildMap(){
  var availH=H-62-200-6,availW=W-16;
  var s=Math.min(availW/((LON1-LON0)*COSL),availH/(LAT1-LAT0));
  s=Math.max(s,40);
  MAP.s=s;MAP.w=(LON1-LON0)*COSL*s;MAP.h=(LAT1-LAT0)*s;
  MAP.left=Math.round((W-MAP.w)/2);MAP.top=Math.round(62+(availH-MAP.h)/2+3);
  var gw=Math.round(MAP.w/3),gh=Math.round(MAP.h/3);
  var sig=gw+'x'+gh;
  var cw=MAP.w/gw,ch=MAP.h/gh;
  var i,j,k,m,p;
  if(sig!==MAP.sig||!MAP.idx){
    MAP.sig=sig;MAP.gw=gw;MAP.gh=gh;
    MAP.cv=document.createElement('canvas');MAP.cv.width=gw;MAP.cv.height=gh;
    MAP.cx=MAP.cv.getContext('2d');MAP.img=MAP.cx.createImageData(gw,gh);
    MAP.idx=new Int16Array(gw*gh);MAP.edge=new Uint8Array(gw*gh);
    var islIdx=[];for(var q=0;q<ISL.length;q++)islIdx.push(ISL[q].sp?NC:cIndex(ISL[q].c));
    for(j=0;j<gh;j++){
      for(i=0;i<gw;i++){
        var lon=LON0+((i+0.5)*cw)/(COSL*s),lat=LAT1-((j+0.5)*ch)/s,id=-1;
        if(inPoly(lon,lat)){
          var best=1e9;
          for(k=0;k<NC;k++){
            var c=COUNTIES[k];
            for(m=0;m<c.seeds.length;m++){
              var dx=(lon-c.seeds[m][0])*COSL,dy=lat-c.seeds[m][1],dd=dx*dx+dy*dy-c.w;
              if(dd<best){best=dd;id=k;}
            }
          }
        }else{
          for(m=0;m<ISL.length;m++){
            var ix=(lon-ISL[m].lon)*COSL,iy=lat-ISL[m].lat;
            if(ix*ix+iy*iy<=ISL[m].r*ISL[m].r){id=islIdx[m];break;}
          }
        }
        MAP.idx[j*gw+i]=id;
      }
    }
    var nb=[[1,0],[-1,0],[0,1],[0,-1]];
    for(j=0;j<gh;j++){
      for(i=0;i<gw;i++){
        p=j*gw+i;var id2=MAP.idx[p];
        if(id2<0){MAP.edge[p]=0;continue;}
        var e=0;
        for(k=0;k<4;k++){
          var ni=i+nb[k][0],nj=j+nb[k][1],nid=(ni<0||nj<0||ni>=gw||nj>=gh)?-1:MAP.idx[nj*gw+ni];
          if(nid<0){e=2;break;}
          if(nid!==id2)e=1;
        }
