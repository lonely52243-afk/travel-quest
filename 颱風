<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="icon" id="favIcon" href="data:,">
<link rel="apple-touch-icon" id="touchIcon" href="">
<link rel="manifest" id="manifestLink" href="">
<meta name="apple-mobile-web-app-title" content="颱風假製造機">
<meta name="theme-color" content="#12162a">
<title>颱風假製造機</title>
<style>
:root{--brown:#6b3f17;--brown2:#4a2a0e;--cream:#f2e3c3;--ink:#2b1a0c;--yellow:#f0c84b;--blue:#4db8ff;--red:#ff5a4a;}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{margin:0;height:100%;background:#0f1424;overflow:hidden;font-family:-apple-system,"PingFang TC","Noto Sans TC","Microsoft JhengHei",sans-serif;color:var(--cream);-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;overscroll-behavior:none;}
input{font-family:inherit;-webkit-user-select:text;user-select:text;}
#app{position:fixed;left:0;top:0;right:0;bottom:0;background:radial-gradient(circle at 50% 46%,#202c52 0%,#12162a 70%);overflow:hidden;}
#app::after{content:"";position:absolute;inset:0;pointer-events:none;z-index:50;background:repeating-linear-gradient(rgba(0,0,0,.07) 0 1px,transparent 1px 3px);}
.screen{position:absolute;left:0;top:0;right:0;bottom:0;display:none;}
.screen.active{display:block;}
.screen.opaque{background:#12162a;z-index:10;overflow-y:auto;-webkit-overflow-scrolling:touch;touch-action:pan-y;padding:calc(env(safe-area-inset-top,0px) + 14px) 18px calc(env(safe-area-inset-bottom,0px) + 18px);}
#cv{position:absolute;left:0;top:0;width:100%;height:100%;z-index:2;pointer-events:none;}
#land{z-index:1;background:linear-gradient(#0a1830,#14405f);}
#landUI,#game,#aim{z-index:3;pointer-events:none;}
#home{z-index:3;}
#home.active{display:flex;flex-direction:column;justify-content:space-between;padding:calc(env(safe-area-inset-top,0px) + 18px) 20px calc(env(safe-area-inset-bottom,0px) + 18px);}
.wrap{max-width:460px;margin:0 auto;display:flex;flex-direction:column;gap:14px;}
h1.title{margin:0;text-align:center;font-size:30px;letter-spacing:3px;color:#ffd34d;text-shadow:3px 3px 0 var(--brown);}
.sub{text-align:center;color:#c9b894;font-size:14px;line-height:1.5;}
.frame{border:5px solid var(--brown);background:#1c1b2e;height:min(34vh,calc(100vw - 36px));}
#demo{width:100%;height:100%;display:block;}
.panel{background:var(--cream);border:5px solid var(--brown);box-shadow:0 6px 0 var(--brown2);padding:10px 14px;color:var(--ink);}
.panel ol{margin:0;padding:0;list-style:none;counter-reset:r;}
.panel li{counter-increment:r;font-size:17px;line-height:1.45;padding:5px 0 5px 28px;position:relative;color:#b8a78a;font-weight:700;transition:color .3s;}
.panel li::before{content:counter(r) ".";position:absolute;left:0;}
.panel li.on{color:var(--ink);}
.chk{display:flex;align-items:center;justify-content:center;gap:12px;font-size:16px;color:#e6d6b4;font-weight:700;}
.chk input{width:30px;height:30px;accent-color:#f0c84b;}
.btn{display:block;width:100%;background:var(--cream);color:var(--ink);border:4px solid var(--brown);box-shadow:0 6px 0 var(--brown2);font-size:22px;font-weight:800;padding:13px;font-family:inherit;letter-spacing:3px;cursor:pointer;}
.btn:active{transform:translateY(4px);box-shadow:0 2px 0 var(--brown2);}
.btn.ghost{background:#2a2f4d;color:var(--cream);font-size:16px;letter-spacing:1px;padding:10px 4px;border-color:#4a5280;box-shadow:0 5px 0 #1a1d33;}
.btn.alt{background:#f0c84b;}
.btn:disabled{opacity:.45;}
.btnrow2{display:flex;gap:10px;}
.btnrow2 .btn{flex:1;}
.best{text-align:center;color:#ffd34d;font-weight:800;font-size:14px;}
/* home */
.logo{text-align:center;margin-top:6px;}
.logo .l1{font-size:54px;font-weight:900;color:#ffd34d;letter-spacing:6px;text-shadow:4px 4px 0 var(--brown),0 0 24px rgba(255,200,60,.5);line-height:1;}
.logo .l2{font-size:40px;font-weight:900;color:#fff;letter-spacing:10px;text-shadow:3px 3px 0 var(--brown);line-height:1.2;}
.logo .l3{margin-top:6px;font-size:14px;color:#c9b894;font-weight:700;}
.menu{display:flex;flex-direction:column;gap:11px;max-width:460px;width:100%;margin:0 auto;}
.nameRow{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:800;color:#e6d6b4;}
.nameRow input{flex:1;background:#0e1226;border:3px solid var(--brown);color:#fff;font-size:17px;font-weight:800;padding:7px 10px;}
.coins{font-weight:900;color:#ffd34d;}
#dailyTxt small{display:block;font-size:12px;letter-spacing:0;font-weight:700;margin-top:2px;}
/* game HUD */
.hud{position:absolute;left:14px;right:14px;top:calc(env(safe-area-inset-top,0px) + 12px);}
.barwrap{height:34px;background:#08070e;border:4px solid var(--brown);position:relative;overflow:hidden;}
#bar{height:100%;width:0%;background:linear-gradient(90deg,#4db8ff,#f0c84b 55%,#ff5a4a);}
#barTxt{position:absolute;left:0;right:0;top:0;bottom:0;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;color:#fff;text-shadow:1px 1px 0 #000;}
.stats{display:flex;justify-content:space-between;margin-top:8px;font-size:14px;font-weight:700;color:var(--cream);text-shadow:1px 1px 0 #000;}
.stats b{font-size:22px;color:#ffd34d;margin:0 3px;}
#cat{margin-top:2px;text-align:center;font-size:20px;font-weight:800;color:#fff;text-shadow:2px 2px 0 var(--brown);}
#tname{text-align:center;font-size:13px;color:#c9b894;margin-top:2px;}
#count{position:absolute;left:0;right:0;top:36%;text-align:center;font-size:96px;font-weight:900;color:#ffd34d;text-shadow:5px 5px 0 var(--brown);}
#vig{position:absolute;left:0;top:0;right:0;bottom:0;pointer-events:none;opacity:0;background:radial-gradient(circle at 50% 50%,transparent 42%,rgba(255,40,30,.6) 100%);}
#vig.warn{animation:vg 1s infinite;}
#vig.crit{animation:vg .5s infinite;}
@keyframes vg{0%,100%{opacity:.15}50%{opacity:.85}}
.stats .urgent{color:#ff8a7a;}
.stats .urgent b{color:#ff4a3a;font-size:32px;display:inline-block;animation:ur .5s infinite alternate;}
@keyframes ur{from{transform:scale(1)}to{transform:scale(1.18)}}
#count.pop{animation:pop .9s ease-out;}
@keyframes pop{0%{transform:scale(1.6);opacity:0}30%{transform:scale(1);opacity:1}100%{transform:scale(1)}}
.hint{position:absolute;left:16px;right:16px;bottom:calc(env(safe-area-inset-bottom,0px) + 16px);background:var(--cream);border:5px solid var(--brown);box-shadow:0 5px 0 var(--brown2);color:var(--ink);text-align:center;font-size:18px;font-weight:800;padding:12px 8px;}
/* aim */
#aimTop{position:absolute;left:12px;right:12px;top:calc(env(safe-area-inset-top,0px) + 8px);text-align:center;}
.aT1{font-size:22px;font-weight:900;color:#fff;text-shadow:2px 2px 0 var(--brown);}
.aT2{font-size:16px;font-weight:800;color:#ffd34d;margin-top:2px;text-shadow:1px 1px 0 #000;}
.aT3{font-size:12px;color:#c9b894;margin-top:2px;}
#aimBar{position:absolute;left:10px;right:10px;bottom:calc(env(safe-area-inset-bottom,0px) + 10px);pointer-events:auto;background:rgba(18,22,42,.92);border:4px solid var(--brown);padding:8px;}
#aimInfo{font-size:13px;line-height:1.45;color:#f2e3c3;font-weight:700;min-height:56px;}
#aimInfo b{color:#ffd34d;font-size:15px;}
#chips{display:flex;gap:6px;overflow-x:auto;touch-action:pan-x;padding:6px 0;-webkit-overflow-scrolling:touch;}
.chip{flex:0 0 auto;min-width:42px;height:42px;background:#2a2f4d;color:#fff;border:3px solid #4a5280;font-size:17px;font-weight:900;font-family:inherit;padding:0 8px;}
.chip.on{background:#f0c84b;color:#2b1a0c;border-color:#8a6a10;}
.aimBtns{display:flex;gap:8px;margin-top:4px;}
.aimBtns .btn{padding:10px;font-size:20px;}
.aimBtns .btn.ghost{flex:0 0 24%;font-size:13px;padding:10px 2px;letter-spacing:0;}
.brk{background:#1d2340;border:3px solid #38406a;padding:8px 12px;font-size:14px;font-weight:700;color:#c9b894;}
.brk div{display:flex;justify-content:space-between;padding:2px 0;gap:10px;}
.brk b{color:#ffd34d;text-align:right;}
.brk .ev{display:block;font-size:12px;color:#ff9b5a;border-top:1px dashed #38406a;margin-top:4px;padding-top:5px;}
/* land */
#landTop{position:absolute;left:12px;right:12px;top:calc(env(safe-area-inset-top,0px) + 8px);text-align:center;}
#landName{font-size:20px;font-weight:900;color:#fff;text-shadow:2px 2px 0 var(--brown);}
#landTally{display:inline-block;font-size:16px;font-weight:800;color:#ffd34d;margin-top:2px;text-shadow:1px 1px 0 #000;}
#landTally.bump{animation:bump .3s ease-out;}
@keyframes bump{0%{transform:scale(1.6);color:#fff}100%{transform:scale(1)}}
#combo{position:absolute;right:14px;top:calc(env(safe-area-inset-top,0px) + 84px);text-align:right;opacity:0;pointer-events:none;transition:opacity .2s;}
#combo.on{opacity:1;}
#cmbN{font-size:54px;font-weight:900;color:#ffd34d;text-shadow:3px 3px 0 #6b3f17,0 0 18px rgba(255,200,60,.7);line-height:1;transform-origin:right center;}
#cmbN.pop{animation:cp .28s ease-out;}
@keyframes cp{0%{transform:scale(2.2) rotate(-6deg)}100%{transform:scale(1) rotate(0)}}
#cmbT{font-size:14px;font-weight:900;color:#fff;text-shadow:1px 1px 0 #000;margin-top:2px;}
#cmbBar{width:120px;height:9px;background:rgba(0,0,0,.6);border:2px solid #6b3f17;margin:5px 0 0 auto;}
#cmbBar i{display:block;height:100%;width:100%;background:#ff8a5a;}
#ticker{position:absolute;left:12px;right:12px;bottom:calc(env(safe-area-inset-bottom,0px) + 10px);min-height:48px;background:var(--cream);border:4px solid var(--brown);box-shadow:0 4px 0 var(--brown2);color:var(--ink);font-size:14px;font-weight:800;padding:8px 10px;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.35;}
#ticker.flash{animation:tk .4s ease-out;}
@keyframes tk{0%{background:#ffd34d}100%{background:var(--cream)}}
/* banner / flash / mute */
#banner{position:absolute;left:0;right:0;top:22%;text-align:center;z-index:55;pointer-events:none;opacity:0;}
#banner b{display:block;font-size:34px;font-weight:900;color:#ffd34d;text-shadow:3px 3px 0 #6b3f17,0 0 18px rgba(255,200,60,.8);}
#banner span{display:block;font-size:15px;color:#fff;font-weight:800;margin-top:4px;text-shadow:1px 1px 0 #000;}
#banner.show{animation:bn 1.7s ease-out;}
@keyframes bn{0%{opacity:0;transform:scale(1.8)}14%{opacity:1;transform:scale(1)}80%{opacity:1}100%{opacity:0;transform:translateY(-22px)}}
#flash{position:absolute;left:0;top:0;right:0;bottom:0;background:#fff;opacity:0;pointer-events:none;z-index:54;}
#flash.show{animation:fl .45s ease-out;}
@keyframes fl{0%{opacity:.55}100%{opacity:0}}
#mute{position:absolute;right:12px;bottom:calc(env(safe-area-inset-bottom,0px) + 84px);width:42px;height:42px;z-index:56;display:none;background:rgba(0,0,0,.55);border:3px solid var(--brown);color:#fff;font-size:20px;padding:0;}
/* result */
.scoreBox{text-align:center;background:#1d2340;border:4px solid #38406a;padding:10px;}
.scoreBox .sl{font-size:13px;color:#c9b894;font-weight:700;}
.scoreBox .sv{font-size:46px;font-weight:900;color:#ffd34d;text-shadow:3px 3px 0 var(--brown);line-height:1.1;}
.scoreBox .sr{font-size:14px;color:#fff;font-weight:800;margin-top:2px;}
.news{background:#000;border:3px solid #444;padding:8px 10px;font-size:15px;font-weight:900;color:#fff;line-height:1.4;}
.news small{display:block;color:#ffd34d;font-size:11px;letter-spacing:2px;margin-bottom:2px;}
.poster{background:#2f2f2f;border:5px solid var(--brown);}
.pHead{background:#000;padding:10px 12px 8px;text-align:center;}
.pBrand{font-size:12px;color:#ffd34d;font-weight:900;letter-spacing:2px;}
.pT1{font-size:24px;font-weight:900;color:#fff;margin-top:2px;}
.pT2{font-size:24px;font-weight:900;color:#ffd34d;}
#rMap{display:block;margin:10px auto 0;width:60%;image-rendering:pixelated;image-rendering:crisp-edges;}
.pList{display:grid;grid-template-columns:1fr 1fr;gap:2px 14px;padding:10px 14px;}
.pRow{display:flex;justify-content:space-between;align-items:baseline;font-size:15px;font-weight:800;color:#fff;border-bottom:1px dashed #555;padding:3px 0;}
.pRow b.y{color:#ffd34d;}
.pRow b.b{color:#4db8ff;}
.pRow b.g{color:#aab4c0;}
.pRow small{display:block;font-size:10px;color:#ff9b5a;font-weight:700;}
.pFoot{padding:0 14px 10px;font-size:11px;color:#9aa;}
.rTitle{text-align:center;font-size:30px;font-weight:900;color:#ffd34d;text-shadow:3px 3px 0 var(--brown);margin-top:2px;}
.rDesc{text-align:center;font-size:15px;color:#e6d6b4;line-height:1.5;font-weight:700;}
.rStats{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.rStats div{background:#1d2340;border:3px solid #38406a;padding:8px;text-align:center;font-size:13px;color:#c9b894;font-weight:700;}
.rStats b{display:block;font-size:18px;color:#ffd34d;margin-top:2px;}
.achNew{background:#2b2410;border:3px solid #8a6a10;padding:8px 10px;font-size:14px;font-weight:800;color:#ffe27a;line-height:1.6;}
/* board / codex / lab / settings */
.tabs{display:flex;gap:8px;}
.tab{flex:1;background:#2a2f4d;color:#cfd6f5;border:3px solid #4a5280;font-size:15px;font-weight:800;padding:8px 2px;font-family:inherit;}
.tab.on{background:#f0c84b;color:#2b1a0c;border-color:#8a6a10;}
.bRow{display:flex;align-items:center;gap:8px;background:#1d2340;border:3px solid #38406a;padding:8px 10px;font-weight:800;}
.bRow.me{border-color:#f0c84b;background:#2b2410;}
.bRow .bR{width:34px;font-size:18px;text-align:center;}
.bRow .bN{flex:1;font-size:16px;color:#fff;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}
.bRow .bS{font-size:18px;color:#ffd34d;}
.bRow small{font-size:11px;color:#9aa5d0;display:block;text-align:right;}
.empty{text-align:center;color:#9aa5d0;font-weight:700;padding:18px 0;line-height:1.6;font-size:14px;}
.cx{background:#1d2340;border:3px solid #38406a;padding:9px 11px;}
.cx.lock{opacity:.55;}
.cx .cxT{font-size:15px;font-weight:900;color:#fff;}
.cx .cxD{font-size:12px;color:#c9b894;font-weight:700;margin-top:2px;line-height:1.45;}
.cx .cxB{font-size:13px;color:#ffd34d;font-weight:800;margin-top:3px;}
.secH{font-size:16px;font-weight:900;color:#ffd34d;margin-top:4px;}
.labRow{display:flex;align-items:center;gap:10px;background:#1d2340;border:3px solid #38406a;padding:10px;}
.labRow .lI{flex:1;}
.labRow .lT{font-size:16px;font-weight:900;color:#fff;}
.labRow .lD{font-size:12px;color:#c9b894;font-weight:700;margin-top:2px;}
.labRow .lL{font-size:12px;color:#ffd34d;font-weight:800;margin-top:2px;}
.labRow .btn{flex:0 0 92px;font-size:14px;padding:8px 2px;letter-spacing:0;}
.setRow{display:flex;align-items:center;justify-content:space-between;background:#1d2340;border:3px solid #38406a;padding:10px 12px;font-size:16px;font-weight:800;}
.setRow .btn{flex:0 0 100px;font-size:14px;padding:8px 2px;letter-spacing:0;}
.note{font-size:12px;color:#9aa5d0;line-height:1.6;font-weight:600;}
#shareModal{position:absolute;left:0;top:0;right:0;bottom:0;z-index:70;background:rgba(0,0,0,.86);display:none;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:18px;}
#shareModal.active{display:flex;}
#shareModal img{max-width:100%;max-height:68vh;border:4px solid var(--brown);-webkit-user-select:auto;user-select:auto;-webkit-touch-callout:default;}
#shareModal .tip{color:#fff;font-weight:800;font-size:14px;text-align:center;}
#toast{position:absolute;left:50%;top:14%;transform:translateX(-50%);background:#000;color:#fff;font-weight:800;padding:10px 16px;z-index:80;display:none;max-width:86%;text-align:center;font-size:14px;line-height:1.5;border:2px solid #f0c84b;}

.marquee{position:absolute;left:0;right:0;top:0;padding-top:env(safe-area-inset-top,0px);background:#b3191a;color:#fff;font-size:13px;font-weight:800;overflow:hidden;white-space:nowrap;border-bottom:3px solid #6b0f10;z-index:2;}
.marquee span{display:inline-block;padding:5px 0 5px 100%;animation:mq 30s linear infinite;}
@keyframes mq{to{transform:translateX(-100%)}}
.logo{padding-top:30px;}
.badge{display:inline-block;background:#f0c84b;color:#2b1a0c;border:3px solid #6b3f17;font-size:13px;font-weight:900;padding:3px 10px;transform:rotate(-3deg);box-shadow:3px 3px 0 #6b3f17;margin-bottom:10px;}
.logo .l1{animation:lg 2.6s ease-in-out infinite;}
@keyframes lg{0%,100%{transform:scale(1) rotate(-1deg)}50%{transform:scale(1.04) rotate(1deg)}}
.homeLine{margin-top:10px;min-height:20px;font-size:14px;font-weight:800;color:#ffe9b0;text-shadow:1px 1px 0 #000;}
.btn{background:linear-gradient(#fff6dc,#f2e3c3 55%,#e0cb98);}
.btn.alt{background:linear-gradient(#ffe27a,#f0c84b 55%,#d9a920);}
.btn.big{font-size:22px;letter-spacing:1px;padding:14px 8px;animation:bp 1.6s ease-in-out infinite;}
@keyframes bp{0%,100%{transform:scale(1)}50%{transform:scale(1.035)}}
.btn.ghost{background:linear-gradient(#343a60,#2a2f4d);}
.barwrap::after{content:"";position:absolute;left:0;top:0;right:0;bottom:0;background:repeating-linear-gradient(90deg,transparent 0 9px,rgba(0,0,0,.35) 9px 11px);z-index:1;}
#barTxt{z-index:2;}
#ticker::before{content:"LIVE";flex:0 0 auto;background:#e33;color:#fff;font-size:11px;font-weight:900;padding:2px 6px;margin-right:8px;animation:bl 1s infinite;}
@keyframes bl{50%{opacity:.35}}
.poster{position:relative;}
#stamp{position:absolute;right:8px;top:150px;border:5px solid #e33;color:#e33;background:rgba(255,255,255,.08);padding:3px 10px;font-size:24px;font-weight:900;letter-spacing:2px;transform:rotate(-14deg);opacity:0;pointer-events:none;}
#stamp.show{animation:st .5s ease-out forwards;}
@keyframes st{0%{transform:rotate(-14deg) scale(3.2);opacity:0}100%{transform:rotate(-14deg) scale(1);opacity:.92}}
.chat{display:flex;flex-direction:column;gap:6px;}
.bub{max-width:82%;padding:7px 11px;border-radius:12px;font-size:14px;font-weight:700;line-height:1.4;}
.bub small{display:block;font-size:11px;opacity:.6;}
.bub.l{background:#fff;color:#222;align-self:flex-start;border-bottom-left-radius:2px;}
.bub.r{background:#7ee27a;color:#111;align-self:flex-end;border-bottom-right-radius:2px;}
.scoreBox.rec{border-color:#ffd34d;box-shadow:0 0 22px rgba(255,211,77,.6);animation:rg 1.2s infinite alternate;}
@keyframes rg{from{box-shadow:0 0 10px rgba(255,211,77,.3)}to{box-shadow:0 0 28px rgba(255,211,77,.9)}}
.tags{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;}
.tag{background:#2b2410;border:2px solid #8a6a10;color:#ffe27a;font-size:12px;font-weight:800;padding:3px 8px;}
#helpModal{position:absolute;left:0;top:0;right:0;bottom:0;z-index:75;background:rgba(0,0,0,.86);display:none;align-items:center;justify-content:center;padding:18px;overflow-y:auto;}
#helpModal.active{display:flex;}
.hbox{background:var(--cream);color:var(--ink);border:5px solid var(--brown);box-shadow:0 6px 0 var(--brown2);padding:16px;max-width:420px;width:100%;}
.hbox h2{margin:0 0 8px;font-size:22px;display:flex;align-items:center;gap:10px;}
.hbox h2 img{width:56px;height:56px;border:3px solid var(--brown);border-radius:12px;}
.hbox ol{margin:0 0 10px;padding-left:22px;font-size:16px;font-weight:700;line-height:1.7;}
.hbox .hn{font-size:13px;font-weight:700;color:#6b4a22;line-height:1.5;margin-bottom:10px;}
.hbox .btn{font-size:18px;padding:10px;margin-top:8px;}
.tip{font-size:14px;font-weight:800;line-height:1.5;}
.tip a{display:inline-block;margin-top:4px;color:#8a3a10;text-decoration:underline;}
#home.active{justify-content:flex-start;gap:12px;overflow-y:auto;}
